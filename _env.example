# ==============================================================================
# BrandGuard AI — Production Environment Variables Reference
# ==============================================================================

# 1. DATABASE (Supabase PostgreSQL Connection Pooler / Direct)
# Obtain from Supabase Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-SUPABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. SUPABASE STORAGE & CLIENT (Optional for persistent object storage)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY-OR-ANON-KEY]

# 3. SECURITY & AUTHENTICATION
# Production JWT Signing Key (64 characters random string)
SECRET_KEY=brandguard-enterprise-production-secure-jwt-key-2026-prod-alpha-99
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 32-byte URL-safe base64 key for AES-256 / Fernet token encryption
# Generate via: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMi1ieXRlLWtleS0yMDI2IQ==

# 4. PRODUCTION HOST DOMAINS
FRONTEND_URL=https://brandguard-ai-web.vercel.app
BACKEND_URL=https://brandguard-ai-backend-jcpz.onrender.com

# 5. MULTIMODAL AI & VISION INFERENCE
# Google Gemini API Key for Multimodal Brand Context Verification & Guidelines Analysis
GEMINI_API_KEY=
OPENAI_API_KEY=

# 6. SOCIAL BROADCAST & INTEGRATION DIRECT LOGINS (Optional OAuth overrides)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_AUTH_MODE=instagram_login
META_WEBHOOK_VERIFY_TOKEN=brandguard_webhook_2026
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
