# ==============================================================================
# BrandGuard AI - Production & Local Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development:
DATABASE_URL=sqlite:///./brandguard.db
# For Production (e.g. Neon PostgreSQL, Supabase, AWS RDS):
# DATABASE_URL=postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/brandguard_db?sslmode=require

# ------------------------------------------------------------------------------
# 2. SECURITY & SECURE TOKEN ENCRYPTION (Phase 8)
# ------------------------------------------------------------------------------
# JWT session token signing secret key (32+ characters)
SECRET_KEY=brandguard-enterprise-production-secure-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 32-byte URL-safe base64 key for AES/Fernet encryption of social media OAuth access & refresh tokens
# Generate via: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. DOMAIN & CALLBACK HOST CONFIGURATION
# ------------------------------------------------------------------------------
# Local:
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
# Production:
# FRONTEND_URL=https://brandguid-ai-two.vercel.app
# BACKEND_URL=https://brandguid-ai-two.vercel.app

# ------------------------------------------------------------------------------
# 4. META / INSTAGRAM / FACEBOOK OAUTH (Phases 4, 5, 12)
# ------------------------------------------------------------------------------
# Obtain from Meta for Developers (developers.facebook.com):
# App Type: Business or Consumer (with Instagram Login for Professionals & Pages API)
META_APP_ID=
META_APP_SECRET=

# Mode: 'instagram_login' (Professional/Creator accounts) or 'meta_graph'
INSTAGRAM_AUTH_MODE=instagram_login

# Exact OAuth Callback URIs to register in Meta App Dashboard:
# Local Development:
#   http://localhost:3000/api/integrations/oauth/instagram/callback
#   http://localhost:3000/api/integrations/oauth/facebook/callback
# Production:
#   https://brandguid-ai-two.vercel.app/api/integrations/oauth/instagram/callback
#   https://brandguid-ai-two.vercel.app/api/integrations/oauth/facebook/callback
META_REDIRECT_URI=
INSTAGRAM_REDIRECT_URI=
FACEBOOK_REDIRECT_URI=

# Webhook verification token for live Instagram/Facebook comment listening
META_WEBHOOK_VERIFY_TOKEN=brandguard_webhook_2026

# ------------------------------------------------------------------------------
# 5. LINKEDIN OAUTH 2.0 (Phase 6)
# ------------------------------------------------------------------------------
# Obtain from LinkedIn Developer Portal (linkedin.com/developers/apps):
# Products required: 'Sign In with LinkedIn using OpenID Connect' and 'Community Management API'
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Exact OAuth Callback URIs to register in LinkedIn Developer Portal:
# Local Development:
#   http://localhost:3000/api/integrations/oauth/linkedin/callback
# Production:
#   https://brandguid-ai-two.vercel.app/api/integrations/oauth/linkedin/callback
LINKEDIN_REDIRECT_URI=

# ------------------------------------------------------------------------------
# 6. GOOGLE & YOUTUBE DATA API V3 (Phase 7)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console (console.cloud.google.com/apis/credentials):
# API required: 'YouTube Data API v3' (Enabled in APIs & Services)
# Credentials: 'OAuth 2.0 Client ID' (Application Type: Web Application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exact OAuth Callback URIs to register in Google Cloud Console:
# Local Development:
#   http://localhost:3000/api/integrations/oauth/youtube/callback
# Production:
#   https://brandguid-ai-two.vercel.app/api/integrations/oauth/youtube/callback
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------------------------
# 7. AI & VISION INTELLIGENCE
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 8. STORAGE & LIMITS
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=52428800
