# ==============================================================================
# BrandGuard AI - Production & Local Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Vercel Production: Use a managed PostgreSQL instance (e.g. Neon, Supabase, Vercel Postgres)
# Example: postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left empty on Vercel, automatically falls back to ephemeral serverless SQLite: sqlite:////tmp/brandguard.db
# For Local Development:
DATABASE_URL=sqlite:///./brandguard.db

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# A strong, unique random secret key for JWT session token signing (32+ characters)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret

# Token expiration in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. AI & VISION INTELLIGENCE
# ------------------------------------------------------------------------------
# Google Gemini API key for Vision Audits, General AI Chat Assistant, and BrandGuard Copilot
# Obtain from: https://aistudio.google.com/app/apikey
# If unset, local deterministic Computer Vision algorithms, OCR and heuristic rule engine execute.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. STORAGE & FILE SYSTEM
# ------------------------------------------------------------------------------
# Serverless platforms (Vercel / AWS Lambda) automatically default to /tmp/uploads.
# For custom S3/blob mounting or persistent disks, specify directory path here:
# UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# On Vercel, requests to /api are automatically rewritten to the backend function.
# Set VITE_API_URL only if backend is hosted on a separate external domain.
# VITE_API_URL=https://api.yourdomain.com/api
